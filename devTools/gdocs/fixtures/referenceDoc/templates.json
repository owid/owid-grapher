                "kind": "authored",
                "description": "The document headline."
            },
            {
                "name": "authors",
                "type": "string[]",
                "optional": false,
                "kind": "authored",
                "description": "Comma-separated author names; see `{guide:refs}`."
            },
            {
                "name": "toc",
                "type": "TocHeadingWithTitleSupertitle[]",
                "optional": true,
                "kind": "computed"
            }
