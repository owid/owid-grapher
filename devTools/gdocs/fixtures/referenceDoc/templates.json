            {
                "name": "Sections",
                "description": "Prose with the evidence for it.",
                "components": ["heading", "text", "chart"],
                "repeats": true
            }
        ],
        "related": [
            { "kind": "template", "id": "data-insight" },
            { "kind": "guide", "id": "refs" }
        ]
    }
]
