{
    "$schema": "node_modules/wrangler/config-schema.json",

    "name": "owid",
    "compatibility_date": "2025-05-05",

    // Sentry v11 requires Node.js compatibility.
    // https://docs.sentry.io/platforms/javascript/guides/cloudflare/#configure
    "compatibility_flags": ["nodejs_compat"],

    // NOTE (Martin): As of 2025-01-24, the bundle exceeded the uncompressed size
    // limit of 25 MiB if we include the source maps, so we disable them for now.
    // "upload_source_maps": true, // To get source maps in Sentry.

    "pages_build_output_dir": "./localBake",

    "r2_buckets": [
        {
            "bucket_name": "owid-grapher-configs-staging",
            "binding": "GRAPHER_CONFIG_R2_BUCKET",
            "remote": true
        },
        {
            "bucket_name": "owid-grapher-configs",
            "binding": "GRAPHER_CONFIG_R2_BUCKET_FALLBACK",
            "remote": true
        },
        {
            "bucket_name": "owid-user-surveys-staging",
            "binding": "USER_SURVEYS_R2"
        }
    ],
    // Workers AI, for the experimental /api/search?rerank= (functions/api/search/rerank.ts).
    // Top level only, i.e. `wrangler pages dev` (local dev and the staging containers),
    // which authenticates with the dev/staging CLOUDFLARE_API_TOKEN. Deliberately not in
    // "preview" (public *.owid.pages.dev URLs) or "production", where the param returns 400.
    "ai": { "binding": "AI", "remote": true },
    "vars": {
        "ENV": "development",
        "GRAPHER_CONFIG_R2_BUCKET_FALLBACK_PATH": "v1",
        "DATA_API_URL_COMPLETE": "https://api.ourworldindata.org/v1/indicators/",
        "CATALOG_URL": "https://catalog.ourworldindata.org"
    },
    "env": {
        "preview": {
            "r2_buckets": [
                {
                    "bucket_name": "owid-grapher-configs-staging",
                    "binding": "GRAPHER_CONFIG_R2_BUCKET",
                    "remote": true
                },
                {
                    "bucket_name": "owid-grapher-configs",
                    "binding": "GRAPHER_CONFIG_R2_BUCKET_FALLBACK",
                    "remote": true
                },
                {
                    "bucket_name": "owid-user-surveys-staging",
                    "binding": "USER_SURVEYS_R2"
                }
            ],
            "vars": {
                // Overrides for CF preview deployments
                "MAILGUN_DOMAIN": "mg.ourworldindata.org",
                "SLACK_ERROR_CHANNEL_ID": "C016H0BNNB1",
                "ENV": "staging",
                "GRAPHER_CONFIG_R2_BUCKET_FALLBACK_PATH": "v1",
                "DATA_API_URL_PARTIAL_PREFIX": "https://api-staging.owid.io/staging-site-",
                "DATA_API_URL_PARTIAL_POSTFIX": "/v1/indicators/",
                "DATA_API_URL_COMPLETE": "",
                // Disable GA4 analytics on preview/staging deployments. Previews
                // are 100%-sampled while prod is 1%, so their hits (esp. bulk
                // crawlers like ClaudeBot hammering *.owid.pages.dev) badly skew
                // any raw event count. "0" passes env validation but shouldSample
                // (Math.random() < 0) is always false, so no events are sent.
                "CLOUDFLARE_GOOGLE_ANALYTICS_SAMPLING_RATE": "0",
                "CATALOG_URL": "https://catalog.ourworldindata.org"
            }
        },
        "production": {
            // Overrides for CF production deployment
            "compatibility_date": "2025-05-05",
            "r2_buckets": [
                {
                    "bucket_name": "owid-grapher-configs",
                    "binding": "GRAPHER_CONFIG_R2_BUCKET",
                    "remote": true
                },
                {
                    "bucket_name": "owid-user-surveys",
                    "binding": "USER_SURVEYS_R2"
                }
            ],
            "vars": {
                "ENV": "production",
                "BAKED_BASE_URL": "https://ourworldindata.org",
                "MAILGUN_DOMAIN": "mg.ourworldindata.org",
                "SLACK_ERROR_CHANNEL_ID": "C5JJW19PS",
                "GRAPHER_CONFIG_R2_BUCKET_FALLBACK_PATH": "",
                "GRAPHER_CONFIG_R2_BUCKET_PATH": "v1",
                "DATA_API_URL_COMPLETE": "https://api.ourworldindata.org/v1/indicators/",
                "CLOUDFLARE_GOOGLE_ANALYTICS_SAMPLING_RATE": "0.01",
                "CATALOG_URL": "https://catalog.ourworldindata.org"
            }
        }
    }
}
