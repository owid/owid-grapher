{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "owid-functions-search-e2e-tests",
    "main": "./search.e2e.worker.ts",
    "compatibility_date": "2025-05-05",
    "vars": {
        // Points at a local Typesense (docker-compose.grapher.yml) with a
        // populated index; "xyz" is the local container's API key. There is no
        // public Typesense endpoint to test against the way there was for
        // Algolia, so these tests are opt-in — see search.e2e.test.ts.
        "TYPESENSE_HOST": "localhost",
        "TYPESENSE_PORT": "8108",
        "TYPESENSE_PROTOCOL": "http",
        "TYPESENSE_SEARCH_KEY": "xyz"
    }
}
