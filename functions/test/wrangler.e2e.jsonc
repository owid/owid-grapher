{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "owid-functions-e2e-tests",
    "main": "./functions.e2e.worker.ts",
    "compatibility_date": "2025-05-05",
    "compatibility_flags": ["nodejs_als"],
    // Intentionally no `remote: true` flags: tests use local Miniflare
    // bindings only.
    "r2_buckets": [
        {
            "binding": "GRAPHER_CONFIG_R2_BUCKET",
            "bucket_name": "test-grapher-configs"
        },
        {
            "binding": "GRAPHER_CONFIG_R2_BUCKET_FALLBACK",
            "bucket_name": "test-grapher-configs-fallback"
        }
    ],
    "d1_databases": [
        {
            "binding": "EMAIL_NOTIFICATIONS_DB",
            "database_name": "test-email-notifications",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "../../d1/email-notifications/migrations"
        }
    ],
    "vars": {
        "CF_PAGES_BRANCH": "test-branch",
        "GRAPHER_CONFIG_R2_BUCKET_PATH": "v1",
        "GRAPHER_CONFIG_R2_BUCKET_FALLBACK_PATH": "v1",
        "POSTMARK_WEBHOOK_SECRET": "webhook:secret"
    }
}
