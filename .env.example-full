TZ=utc

# Should be set to "production" in prod deployment. Defaults to "production" if unset.
ENV=development

# Instance configuration (for running multiple parallel dev environments)
TMUX_SESSION_NAME=grapher  # optional; tmux session name to avoid conflicts
COMPOSE_PROJECT_NAME=owid-grapher  # optional; docker compose project name for isolated volumes
VITE_PORT=8090  # optional; port for vite dev server
WRANGLER_PORT=8788  # optional; port for cloudflare functions dev server

GRAPHER_DB_NAME=grapher
GRAPHER_DB_USER=grapher
GRAPHER_DB_PASS=grapher
GRAPHER_DB_HOST=127.0.0.1
GRAPHER_DB_PORT=3307

GRAPHER_TEST_DB_NAME=graphertest
GRAPHER_TEST_DB_USER=graphertest
GRAPHER_TEST_DB_PASS=graphertest
GRAPHER_TEST_DB_HOST=127.0.0.1
GRAPHER_TEST_DB_PORT=3308

GDOCS_PRIVATE_KEY=
GDOCS_CLIENT_EMAIL=
# Templates that are duplicated as-is when creating a new document
GDOCS_ARTICLE_DUPLICATION_TEMPLATE_ID=
GDOCS_DATA_INSIGHT_DUPLICATION_TEMPLATE_ID=
GDOCS_ANNOUNCEMENT_DUPLICATION_TEMPLATE_ID=
# Template document used as the starting point for an automation workflow
GDOCS_DATA_INSIGHT_API_TEMPLATE_ID=

GDOCS_DONATE_FAQS_DOCUMENT_ID=
GDOCS_REFERENCE_DOCUMENT_ID=  # optional; target of yarn buildGdocsReferenceDoc
GDOCS_BACKPORTING_TARGET_FOLDER=  # optional

R2_ENDPOINT=  # optional
R2_ACCESS_KEY_ID=  # optional
R2_SECRET_ACCESS_KEY=  # optional
# These two GRAPHER_CONFIG_ settings are used to store grapher configs in an R2 bucket.
# The cloudflare workers for thumbnail rendering etc use these settings to fetch the grapher configs.
# This means that for most local dev it is not necessary to set these.
GRAPHER_CONFIG_R2_BUCKET= # optional - for local dev set it to "owid-grapher-configs-staging"
GRAPHER_CONFIG_R2_BUCKET_PATH= # optional - for local dev set it to "devs/YOURNAME"

# Images uploaded via /admin/images live in Cloudflare Images, which does NOT have
# separate environments for production, staging and dev: every environment reads and
# writes the same store. Be careful not to upload images meant for only one
# environment, and especially careful when deleting images.
CLOUDFLARE_IMAGES_ACCOUNT_ID= # Available in Cloudflare, on the main "images" page.
CLOUDFLARE_IMAGES_API_KEY= # Generate your own with read and write permissions, can be the same as other Cloudflare API keys, e.g. R2_SECRET_ACCESS_KEY.
CLOUDFLARE_IMAGES_URL= # optional in development (defaults to the production delivery URL); available in Cloudflare, on the main "images" page. A full URL: "https://imagedelivery.net/<id>", or "https://ourworldindata.org/cdn-cgi/imagedelivery/<id>" as in production.

OWID_ASSETS_R2_ACCESS_KEY= # optional; R2 access key for the owid-assets storage bucket
OWID_ASSETS_R2_SECRET_KEY= # optional; R2 secret key for the owid-assets storage bucket
OWID_ASSETS_R2_BUCKET= # optional; the bucket name e.g. 'owid-assets'

OPENAI_API_KEY=
FIGMA_API_KEY= # optional

# GRAPHER_DYNAMIC_THUMBNAIL_URL=http://localhost:8788/grapher  # optional; unset, development uses production's thumbnails (an empty value disables them)
GDOCS_CHART_PREVIEW_GRAPHER_URL=  # optional; where Google fetches chart preview images for gdocs from, must be public; defaults to https://ourworldindata.org/grapher
GDOCS_CHART_PREVIEW_EXPLORER_URL=  # optional; same for explorers; defaults to https://ourworldindata.org/explorers

# enable search (readonly)
ALGOLIA_ID=   # optional
ALGOLIA_SEARCH_KEY=  # optional
ALGOLIA_CACHED_QUERIES_URL=  # optional; caching proxy for empty-query searches, e.g. http://localhost:8788/api/search/cached-queries (disabled by default in development)

# write records to a (staging) search index
ALGOLIA_INDEX_PREFIX=  # optional; also applied when reading
ALGOLIA_SECRET_KEY=  # optional
ALGOLIA_INDEXING=false  # optional

DATA_API_URL= # optional

SLACK_BOT_OAUTH_TOKEN= # optional
SLACK_DI_PITCHES_CHANNEL_ID= # optional; #data-insight-pitches channel id
SLACK_ALGOLIA_INDEXING_CHANNEL_ID= # optional; channel for Algolia indexing failure reports

# for remote dev on tailscale without localhost + port forwarding
ADMIN_SERVER_HOST= # optional; e.g: YOURMACHINE.TAILXXX.ts.net (find this in the tailscale admin panel)
ADMIN_BASE_URL= # optional; e.g: http://YOURMACHINE.TAILXXX.ts.net
VITE_HOST= # optional; e.g: YOURMACHINE.TAILXXX.ts.net
VITE_DEV_URL= # optional; e.g: http://YOURMACHINE.TAILXXX.ts.net:8090 (should match VITE_PORT if set)

BESPOKE_BASE_URL= # optional; where bespoke component bundles are served from, e.g. "http://localhost:8089" for local dev server
BESPOKE_DATA_URL= # optional; where the ETL data feeds bespoke components fetch are served from, e.g. "https://api.ourworldindata.org/v1/bespoke"
