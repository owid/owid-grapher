{
    "baseDir": "./dist/assets",
    "defaultCompression": "brotli",
    "pathLabels": {
        "hash": "[a-zA-Z0-9_-]+"
    },
    "files": [
        {
            "path": "owid.<hash>.mjs",
            "maxSize": "800kB",
            "maxPercentIncrease": 2
        },
        {
            "path": "owid.<hash>.css",
            "maxSize": "61kB"
        }
    ],
    "groups": [
        {
            "compression": "none",
            "friendlyName": "JS files (uncompressed)",
            "path": "**/*.{js,mjs}"
        },
        {
            "compression": "none",
            "friendlyName": "CSS files (uncompressed)",
            "path": "**/*.css"
        }
    ],
    "includeCommitMessage": true,
    "reportOutput": [
        [
            "github",
            {
                "checkRun": true,
                "commitStatus": true,
                "prComment": "on-failure"
            }
        ]
    ]
}
