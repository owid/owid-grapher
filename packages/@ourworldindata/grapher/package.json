{
    "name": "@ourworldindata/grapher",
    "version": "0.0.2",
    "description": "OWID's data exploration and visualization library.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/owid/owid-grapher.git",
        "directory": "packages/@ourworldindata/grapher"
    },
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "publishConfig": {
        "registry": "https://packages.owid.io",
        "main": "dist/grapher.js",
        "types": "dist/grapher.d.ts",
        "exports": {
            ".": {
                "types": "./dist/grapher.d.ts",
                "import": "./dist/grapher.js"
            },
            "./grapher.css": "./dist/grapher.css",
            "./standalone": {
                "types": "./dist/grapher.d.ts",
                "import": "./dist/grapher.standalone.min.js"
            }
        }
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "files": [
        "dist/grapher.js",
        "dist/grapher.js.map",
