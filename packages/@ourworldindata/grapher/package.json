        "dist/grapher.standalone.min.js.map",
        "dist/grapher.css",
        "dist/grapher.d.ts",
        "dist/grapher.d.ts.map"
    ],
    "scripts": {
        "build": "tsdown",
        "startDemoServer": "http-server . -p 8433 -c-1 -o /demo.html",
        "testPackage": "vitest run --config vitest.package.config.ts"
    },
    "directories": {
        "lib": "src"
    },
